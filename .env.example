# ── Required ────────────────────────────────────────────────────────
# Admin passphrase for the studio admin + portfolio admin APIs (server-only,
# never exposed to the client). Set a strong value in Vercel → Project →
# Settings → Environment Variables.
ADMIN_PASSWORD=change-me

# ── Production storage (Vercel Blob) ────────────────────────────────
# Auto-added when you connect a Blob store to the project in Vercel
# (Storage → Create → Blob → Connect). With this set, uploads AND the
# JSON data (portfolio, music catalogue) persist to Blob. Without it,
# everything falls back to the local filesystem — fine for `npm run dev`,
# but writes do NOT persist on Vercel.
BLOB_READ_WRITE_TOKEN=

# ── Contact form (Formspree) ────────────────────────────────────────
# Your Formspree endpoint, e.g. https://formspree.io/f/abcdwxyz
# When set, the contact form posts here (messages arrive by email).
# When empty, it posts to the local /api/messages inbox instead.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# ── Optional ────────────────────────────────────────────────────────
# Canonical site URL for OpenGraph/Twitter image resolution.
# Vercel provides VERCEL_URL automatically; set this only for a custom domain.
NEXT_PUBLIC_SITE_URL=
